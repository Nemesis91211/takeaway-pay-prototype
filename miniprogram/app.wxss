page { min-height: 100%; background: #f4f5f6; color: #202124; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { background: transparent; }
button::after { border: 0; }
button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 0 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.page { min-height: 100vh; padding: 24rpx 28rpx 150rpx; box-sizing: border-box; background: #f5f6f8; }
.hero { padding: 24rpx 4rpx 22rpx; }.eyebrow { display:none; }.title { margin-top: 8rpx; color: #202124; font-size: 46rpx; font-weight: 700; letter-spacing: -1rpx; }.subtitle { display:none; }
.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 18rpx; background: #fff; box-sizing: border-box; box-shadow: 0 2rpx 12rpx rgba(45,48,54,.035); }.card-title { color: #222428; font-size: 32rpx; font-weight: 700; }.muted { color: #92959a; font-size: 25rpx; }.row { display: flex; align-items: center; justify-content: space-between; }.stack { display: flex; flex-direction: column; gap: 14rpx; }
.primary { width:100%; height: 88rpx; margin: 18rpx 0 0; border-radius: 16rpx; background: #ffcf19; color: #322a00; font-size: 30rpx; font-weight: 700; }.secondary { width:100%; height: 80rpx; margin: 16rpx 0 0; border-radius: 16rpx; background: #fff8d7; color: #806300; font-size: 28rpx; }.ghost { width:100%; height: 76rpx; margin: 14rpx 0 0; border-radius: 14rpx; border: 1rpx solid #e4e5e7; color: #606368; font-size: 27rpx; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.metric { padding: 22rpx; border-radius: 18rpx; background: #fff; }.metric-value { margin-top: 8rpx; color: #202124; font-size: 40rpx; font-weight: 700; }.metric-label { color: #8b8e92; font-size: 24rpx; }
.nav-list { display: flex; flex-direction: column; gap: 14rpx; }.nav-item { display: flex; align-items: center; justify-content: space-between; padding: 26rpx; border-radius: 18rpx; background: #fff; }.nav-main { display: flex; align-items: center; }.nav-icon { width: 62rpx; height: 62rpx; margin-right: 18rpx; border-radius: 18rpx; background: #fff1b7; color: #725600; font-size: 30rpx; line-height: 62rpx; text-align: center; }.nav-name { color: #24262a; font-size: 29rpx; font-weight: 600; }.nav-desc { display:none; }.arrow { color: #a6a8ab; font-size: 38rpx; }
.field { display: block; margin-top: 18rpx; }.label { display: block; margin-bottom: 10rpx; color: #65686d; font-size: 25rpx; }.input, .textarea, .select { width: 100%; min-height: 78rpx; padding: 0 22rpx; border: 1rpx solid #e4e5e7; border-radius: 14rpx; background: #fafafa; box-sizing: border-box; color: #24262a; font-size: 28rpx; line-height: 78rpx; }.textarea { height: 150rpx; padding-top: 18rpx; line-height: 42rpx; }.select { color: #55585d; }.amount-input { color: #b47f00; font-size: 42rpx; font-weight: 700; }
.tag { display: inline-block; padding: 7rpx 15rpx; border-radius: 24rpx; background: #fff2bd; color: #906c00; font-size: 23rpx; }.tag.green { background: #e8f7eb; color: #2d8750; }.tag.gray { background: #f0f1f2; color: #7b7e83; }.tag.red { background: #ffebeb; color: #b84c4c; }
.bottom-space { height: 100rpx; }
.role-card .muted, .profile-card .muted, .my-entry-copy .muted, .notice { display:none; }
.row button { width:auto; min-width:0; }
.actions button { min-width:0; }
.dashboard-head { display:flex; align-items:center; justify-content:space-between; padding:12rpx 4rpx 24rpx; }.head-title { color:#202124; font-size:42rpx; font-weight:700; }.head-caption { margin-top:8rpx; color:#8b8e93; font-size:24rpx; }.head-avatar { width:72rpx; height:72rpx; border-radius:24rpx; background:#202124; color:#fff; font-size:30rpx; line-height:72rpx; text-align:center; }
.summary-card { padding:30rpx; border-radius:22rpx; background:#202124; color:#fff; }.summary-label { color:#b9bdc4; font-size:24rpx; }.summary-value { margin-top:10rpx; font-size:60rpx; font-weight:700; letter-spacing:1rpx; }.summary-foot { display:flex; justify-content:space-between; margin-top:26rpx; padding-top:22rpx; border-top:1rpx solid rgba(255,255,255,.12); color:#d1d4d8; font-size:24rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:30rpx 4rpx 14rpx; }.section-title { color:#26282c; font-size:31rpx; font-weight:700; }.section-link { color:#a17b00; font-size:24rpx; }
.quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }.quick-item { display:flex; align-items:center; padding:22rpx 20rpx; border-radius:17rpx; background:#fff; }.quick-icon { width:54rpx; height:54rpx; margin-right:14rpx; border-radius:16rpx; background:#fff1b6; color:#775a00; font-size:26rpx; line-height:54rpx; text-align:center; }.quick-name { color:#292b2f; font-size:27rpx; font-weight:600; }.quick-count { margin-top:4rpx; color:#a17b00; font-size:23rpx; }
.task-item { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #f0f1f2; }.task-item:last-child { border-bottom:0; }.task-icon { width:52rpx; height:52rpx; margin-right:16rpx; border-radius:50%; background:#fff2c7; color:#927000; font-size:23rpx; line-height:52rpx; text-align:center; }.task-copy { flex:1; }.task-name { color:#2b2d31; font-size:27rpx; }.task-meta { margin-top:6rpx; color:#989ba0; font-size:23rpx; }.task-arrow { color:#b5b8bc; font-size:34rpx; }
.bottom-nav { position:fixed; right:0; bottom:0; left:0; z-index:20; display:flex; justify-content:space-around; padding:14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #eceef0; background:rgba(255,255,255,.98); box-sizing:border-box; }.bottom-tab { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:flex-start; height:72rpx; color:#a1a4a8; font-size:22rpx; line-height:32rpx; }.bottom-tab text { display:block; height:32rpx; line-height:32rpx; white-space:nowrap; }.bottom-tab.active { color:#9b7500; font-weight:700; }.bottom-tab-icon { flex:none; width:40rpx; height:40rpx; margin:0 0 4rpx; border-radius:12rpx; background-color:#f0f1f2; color:transparent; font-size:0; line-height:40rpx; text-align:center; }.bottom-tab.active .bottom-tab-icon { background-color:#fff0aa; }
.bottom-tab.active:nth-child(1) .bottom-tab-icon, .bottom-tab.active:nth-child(2) .bottom-tab-icon, .bottom-tab.active:nth-child(3) .bottom-tab-icon, .bottom-tab.active:nth-child(4) .bottom-tab-icon { background-image:none; }
.quick-icon { font-size:0; background-position:center; background-repeat:no-repeat; background-size:34rpx 34rpx; }
.quick-image { flex:none; width:54rpx; height:54rpx; margin-right:14rpx; padding:10rpx; border-radius:16rpx; background:#fff1b6; box-sizing:border-box; }.task-icon image { width:30rpx; height:30rpx; margin:11rpx; }.nav-icon { display:block; flex:none; width:40rpx; height:40rpx; margin:0 0 4rpx; }
.role-icon { font-size:0; background-position:center; background-repeat:no-repeat; background-size:46rpx 46rpx; }.role-icon.blue { }.profile-avatar { font-size:0; background-position:center; background-repeat:no-repeat; background-size:44rpx 44rpx; }
.bottom-tab-icon::before { display:block; color:#686b70; font-size:25rpx; line-height:40rpx; text-align:center; }.bottom-tab.active .bottom-tab-icon::before { color:#846300; }.bottom-tab:nth-child(1) .bottom-tab-icon::before { content:'⌂'; }.bottom-tab:nth-child(2) .bottom-tab-icon::before { content:'▣'; }.bottom-tab:nth-child(3) .bottom-tab-icon::before { content:'◈'; }.bottom-tab:nth-child(4) .bottom-tab-icon::before { content:'⚙'; }.quick-icon::before { display:block; color:#775a00; font-size:28rpx; line-height:54rpx; text-align:center; }.quick-item:nth-child(1) .quick-icon::before { content:'▣'; }.quick-item:nth-child(2) .quick-icon::before { content:'◫'; }.quick-item:nth-child(3) .quick-icon::before { content:'◎'; }.quick-item:nth-child(4) .quick-icon::before { content:'◈'; }
.filter-bar { display:flex; gap:12rpx; padding:4rpx 0 18rpx; overflow-x:auto; }.filter { flex:none; padding:12rpx 22rpx; border-radius:30rpx; background:#fff; color:#797c81; font-size:24rpx; }.filter.active { background:#202124; color:#fff; }
.empty-state { margin-top:22rpx; padding:70rpx 20rpx; border-radius:18rpx; background:#fff; color:#9a9da1; font-size:26rpx; text-align:center; }
.head-avatar, .floating-settings { display:none; }
.head-caption, .subtitle, .modal-subtitle { display:none !important; }
.dashboard-head { display:none; }
.bottom-tab:first-child > text { font-size:0; }.bottom-tab:first-child > text::after { content:'首页'; font-size:22rpx; }

/* 微信开发者工具模拟器对全局 WXSS 的绝对 background-image 会拼接内部调试后缀，
   改用已有的符号回退，避免模拟器请求不存在的拼接路径。 */
.bottom-tab-icon, .quick-icon, .role-icon, .profile-avatar { background-image:none !important; }
.role-icon::before, .profile-avatar::before { display:block; color:#775a00; font-size:30rpx; line-height:76rpx; text-align:center; content:'◎'; }
.role-icon.blue::before { content:'◈'; }
