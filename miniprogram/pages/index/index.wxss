page { background: #f2f2f2; }
.share-canvas { position: fixed; left: -9999px; top: -9999px; width: 500px; height: 400px; }
.page-shell { padding: 36rpx 28rpx 260rpx; min-height: 100vh; box-sizing: border-box; }.sender-row { display: flex; align-items: center; margin: 3rpx 12rpx 28rpx; }.avatar { position: relative; width: 76rpx; height: 76rpx; border-radius: 50%; background: #f9f9f9; margin-right: 18rpx; box-shadow: 0 2rpx 7rpx rgba(0,0,0,.09); overflow: visible; }.avatar-ear { position: absolute; top: -10rpx; width: 25rpx; height: 27rpx; border-radius: 80% 20% 60% 30%; background: #313237; }.left-ear { left: 7rpx; transform: rotate(27deg); }.right-ear { right: 7rpx; transform: scaleX(-1) rotate(27deg); }.avatar-face { position: absolute; left: 12rpx; top: 21rpx; width: 52rpx; height: 42rpx; border-radius: 46% 46% 50% 50%; background: #eff0ef; }.eye { position: absolute; top: 13rpx; left: 13rpx; width: 6rpx; height: 8rpx; border-radius: 50%; background: #313237; }.right-eye { left: 33rpx; }.sender-name { color: #222; font-size: 32rpx; font-weight: 700; line-height: 42rpx; }.sender-message { color: #777; font-size: 30rpx; line-height: 42rpx; margin-top: 2rpx; }
.status-card, .order-card { border-radius: 20rpx; background: #fff; box-sizing: border-box; }.status-card { padding: 44rpx 50rpx 50rpx; text-align: center; }.status-title { font-size: 38rpx; color: #24262a; font-weight: 700; line-height: 62rpx; }.time-label, .amount-label { margin-top: 25rpx; color: #8a8d91; font-size: 26rpx; }.countdown { color: #202124; font-size: 76rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 102rpx; }.divider { height: 1rpx; background: #ededed; margin: 38rpx 0 26rpx; }.amount-label { margin-top: 0; }.amount { margin-top: 8rpx; color: #18191b; font-size: 80rpx; font-weight: 700; line-height: 110rpx; }.currency { font-size: 38rpx; margin-right: 6rpx; vertical-align: 8rpx; }.primary-button { margin-top: 38rpx; height: 90rpx; line-height: 90rpx; border-radius: 16rpx; background: var(--primary); color: var(--primary-text); font-size: 32rpx; font-weight: 700; }.notice-box { margin-top: 29rpx; text-align: left; padding: 28rpx 30rpx; border-radius: 16rpx; color: #BE8A43; background: #FFF6D8; font-size: 27rpx; line-height: 42rpx; }.notice-title { margin-bottom: 12rpx; color: #C08D46; font-size: 29rpx; font-weight: 500; }
.active-status-title { margin-top: 4rpx; }.active-amount { margin-top: 14rpx; }.time-row { display: flex; justify-content: center; align-items: center; margin-top: 12rpx; color: #787a7d; font-size: 28rpx; }.time-block { width: 36rpx; height: 40rpx; margin-left: 9rpx; border-radius: 6rpx; background: #333438; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 40rpx; }.time-separator { margin-left: 4rpx; color: #55575b; font-size: 30rpx; font-weight: 700; }.active-notice { margin-top: 70rpx; }.active-share-button { display: flex; align-items: center; justify-content: center; margin-top: 32rpx; padding: 0; text-align: center; }.self-pay { margin-top: 32rpx; color: #aaaeb3; font-size: 29rpx; }.self-pay text { margin-left: 6rpx; font-size: 40rpx; line-height: 10rpx; vertical-align: -2rpx; }
.order-card { margin-top: 24rpx; padding: 30rpx; }.merchant-row { display: flex; align-items: center; justify-content: space-between; }.merchant { max-width: 570rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #282a2d; font-size: 31rpx; font-weight: 700; }.merchant-arrow { color: #96989b; font-size: 42rpx; line-height: 40rpx; }.item-row { display: flex; margin-top: 24rpx; }.food-visual { position: relative; flex: 0 0 118rpx; width: 118rpx; height: 118rpx; border-radius: 15rpx; background: linear-gradient(145deg,#fff4df,#f2bd6a); overflow: hidden; }.food-bowl { position: absolute; left: 17rpx; bottom: 16rpx; font-size: 70rpx; line-height: 76rpx; }.food-dot { position: absolute; border-radius: 50%; background: #ee8d42; opacity: .72; }.dot-one { width: 28rpx; height: 28rpx; top: 14rpx; left: 18rpx; }.dot-two { width: 20rpx; height: 20rpx; top: 20rpx; right: 19rpx; background:#79af5c; }.dot-three { width: 14rpx; height: 14rpx; top: 49rpx; right: 15rpx; background:#e1564c; }.item-main { min-width: 0; flex: 1; margin-left: 20rpx; }.item-name { color:#26272a; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }.item-detail { color:#929497; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size: 25rpx; line-height: 37rpx; margin-top: 6rpx; }.item-count { color:#76787a; font-size: 26rpx; margin-top: 5rpx; }.price-column { flex: 0 0 105rpx; text-align: right; }.item-price { color:#242528; font-size: 29rpx; line-height: 39rpx; }.original-price { color:#96989b; font-size: 24rpx; text-decoration: line-through; margin-top: 10rpx; }.share-tip { text-align: center; margin: 34rpx 0; color: #a1a3a6; font-size: 23rpx; }
.privacy-switch { display: flex; align-items: center; color: #a1a3a7; font-size: 26rpx; font-weight: 400; }.switch-track { width: 52rpx; height: 32rpx; margin-left: 8rpx; border-radius: 20rpx; background: #f1f1f1; box-shadow: inset 0 0 0 2rpx #e4e4e4; }.switch-track view { width: 28rpx; height: 28rpx; margin: 2rpx; border-radius: 50%; background: #fff; box-shadow: 0 1rpx 4rpx rgba(0,0,0,.14); }
.share-guide-mask { position: fixed; z-index: 99; inset: 0; background: rgba(0, 0, 0, .60); }.guide-pointer { position: absolute; top: 0; right: 108rpx; width: 4rpx; height: 154rpx; }.guide-line { width: 4rpx; height: 126rpx; border-left: 4rpx dotted #fff; }.guide-dot { width: 22rpx; height: 22rpx; margin-left: -9rpx; border-radius: 50%; background: #fff; }.guide-content { position: absolute; top: 280rpx; right: 0; left: 0; display: flex; flex-direction: column; align-items: center; }.guide-text { color: #fff; font-size: 34rpx; font-weight: 600; line-height: 48rpx; text-align: center; }.guide-close { width: 230rpx; height: 72rpx; margin-top: 42rpx; padding: 0; border: 3rpx solid #fff; border-radius: 40rpx; color: #fff; font-size: 34rpx; font-weight: 600; line-height: 66rpx; text-align: center; box-sizing: border-box; }
.notify-paid-button { display:flex; align-items:center; justify-content:center; width:100%; height:84rpx; padding:0; margin-top:20rpx; background:#fff7d7; color:#856700; line-height:84rpx; white-space:nowrap; }
.primary-button { display:flex; align-items:center; justify-content:center; padding:0; box-sizing:border-box; white-space:nowrap; }
