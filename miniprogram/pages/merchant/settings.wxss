.page { padding-bottom:150rpx; }.settings-page { padding-top:18rpx; }.settings-head { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 20rpx; }.eyebrow { color:#a17b00; font-size:23rpx; font-weight:600; letter-spacing:1rpx; }.page-title { margin-top:6rpx; color:#202124; font-size:44rpx; font-weight:700; }.status-tag { display:inline-block; padding:7rpx 14rpx; border-radius:20rpx; background:#f0f1f2; color:#7b7e83; font-size:22rpx; }.status-tag.green { background:#e8f7eb; color:#2d8750; }.profile-card { display:flex; align-items:center; gap:18rpx; }.profile-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border-radius:24rpx; background:#fff1b6; }.profile-icon image { width:44rpx; height:44rpx; }.profile-icon.has-avatar { overflow:hidden; }.profile-icon.has-avatar image { width:76rpx; height:76rpx; }.profile-summary { flex:1; min-width:0; }.settings-list { padding:0 24rpx; }.setting-row { display:flex; align-items:center; justify-content:space-between; min-height:106rpx; border-bottom:1rpx solid #f0f1f2; }.setting-row:last-child { border-bottom:0; }.setting-row > view:first-child { min-width:0; }.setting-name { color:#292b2f; font-size:28rpx; }.setting-meta { margin-top:7rpx; overflow:hidden; color:#999ca0; font-size:23rpx; text-overflow:ellipsis; white-space:nowrap; }.setting-value { margin-left:18rpx; color:#a17b00; font-size:25rpx; white-space:nowrap; }.readonly { color:#a1a4a8; font-size:22rpx; }
