<view class="page wallet-page">
  <view class="wallet-head"><view><view class="eyebrow">资金中心</view><view class="page-title">钱包</view></view><button class="withdraw-entry" bindtap="withdraw">申请提现</button></view>
  <view class="balance-card"><view class="muted light-text">可提现余额</view><view class="balance">¥{{balance}}</view><view class="balance-foot"><text>提现中 ¥{{frozen}}</text><text>累计结算 ¥{{settled}}</text></view></view>
  <view class="section-head"><view class="section-title">资金流水</view><view class="section-link">{{ledger.length}} 笔</view></view>
  <scroll-view class="ledger-tabs" scroll-x="true" show-scrollbar="false"><view class="ledger-tab {{filter === '全部' ? 'active' : ''}}" bindtap="setFilter" data-filter="全部">全部</view><view class="ledger-tab {{filter === '收入' ? 'active' : ''}}" bindtap="setFilter" data-filter="收入">结算收入</view><view class="ledger-tab {{filter === '提现' ? 'active' : ''}}" bindtap="setFilter" data-filter="提现">提现记录</view></scroll-view>
  <view wx:if="{{ledger.length}}"><view class="card ledger" wx:for="{{ledger}}" wx:key="id"><view class="ledger-main"><view class="ledger-title">{{item.title}}</view><view class="muted">{{item.time}} · {{item.type}}</view></view><view class="ledger-amount {{item.type === '收入' ? 'income' : ''}}">{{item.amount}}</view></view></view>
  <view wx:else class="empty-state"><view class="empty-icon"><image src="/images/icons/business.png" mode="aspectFit"/></view><view>暂无资金流水</view><text>订单结算或提现后会显示在这里</text></view>
  <view class="bottom-nav"><view class="bottom-tab" bindtap="home"><image class="nav-icon" src="/images/icons/home.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab" bindtap="orders"><image class="nav-icon" src="/images/icons/goods.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/business-active.png" mode="aspectFit"/><text>钱包</text></view><view class="bottom-tab" bindtap="settings"><image class="nav-icon" src="/images/icons/usercenter.png" mode="aspectFit"/><text>我的</text></view></view>
</view>
