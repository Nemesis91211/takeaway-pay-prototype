<view class="page withdraw-page">
  <view class="withdraw-head"><view><view class="eyebrow">资金申请</view><view class="page-title">申请提现</view></view><button class="back-button" bindtap="wallet">返回钱包</button></view>
  <view class="card withdraw-form"><view class="available"><text>可提现余额</text><text>¥{{stateBalance}}</text></view><view class="field"><text class="label">提现金额</text><input class="input amount-input" type="digit" value="{{amount}}" bindinput="onInput" placeholder="¥ 0.00"/></view><view class="field"><text class="label">收款方式</text><view class="select" bindtap="choose">{{method}} <text>›</text></view></view><view class="account-hint">收款账号：{{account || '请先完善代理人联系方式'}}</view><view class="notice">提现提交后由管理员审核并人工打款，首期不会自动扣款或自动转账。</view><button class="primary" bindtap="submit">提交提现申请</button></view>
  <view class="section-head"><view class="section-title">提现记录</view><view class="section-link">{{history.length}} 笔</view></view>
  <scroll-view class="status-tabs" scroll-x="true" show-scrollbar="false"><view class="status-tab {{filter === '全部' ? 'active' : ''}}" bindtap="setFilter" data-filter="全部">全部</view><view class="status-tab {{filter === '待审核' ? 'active' : ''}}" bindtap="setFilter" data-filter="待审核">待审核</view><view class="status-tab {{filter === '待打款' ? 'active' : ''}}" bindtap="setFilter" data-filter="待打款">待打款</view><view class="status-tab {{filter === '已完成' ? 'active' : ''}}" bindtap="setFilter" data-filter="已完成">已完成</view><view class="status-tab {{filter === '已驳回' ? 'active' : ''}}" bindtap="setFilter" data-filter="已驳回">已驳回</view></scroll-view>
  <view wx:if="{{history.length}}"><view class="withdraw-card" wx:for="{{history}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}"><view class="card-top"><view><view class="withdraw-amount">¥{{item.amount}}</view><view class="card-time">{{item.createdAt}}</view></view><text class="status-tag {{item.statusClass}}">{{item.status}}</text></view><view class="meta-line"><text>{{item.method}}</text><text>{{item.maskedAccount}}</text></view><view wx:if="{{item.rejectReason}}" class="reject-line">驳回原因：{{item.rejectReason}}</view><view class="detail-hint">查看详情 <text>›</text></view></view></view>
  <view wx:else class="empty-state"><view class="empty-icon"><image src="/images/icons/business.png" mode="aspectFit"/></view><view>暂无提现记录</view><text>提交申请后会显示处理进度</text></view>
  <view wx:if="{{detailVisible}}" class="modal-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="stopPropagation"><view class="sheet-head"><view><view class="sheet-title">提现详情</view><view class="sheet-id">{{selected.id}}</view></view><text class="sheet-close" catchtap="closeDetail">×</text></view><view class="detail-hero"><view class="detail-amount">¥{{selected.amount}}</view><text class="status-tag {{selected.statusClass}}">{{selected.status}}</text></view><view class="detail-section"><view class="detail-row"><text>提现方式</text><text>{{selected.method}}</text></view><view class="detail-row"><text>收款账号</text><text>{{selected.maskedAccount}}</text></view><view class="detail-row"><text>申请时间</text><text>{{selected.createdAt}}</text></view><view wx:if="{{selected.reviewedAt}}" class="detail-row"><text>审核时间</text><text>{{selected.reviewedAt}}</text></view><view wx:if="{{selected.paidAt}}" class="detail-row"><text>打款时间</text><text>{{selected.paidAt}}</text></view><view wx:if="{{selected.rejectReason}}" class="detail-note"><text>驳回原因</text><text>{{selected.rejectReason}}</text></view></view></view></view>
  <view class="bottom-nav"><view class="bottom-tab" bindtap="home"><image class="nav-icon" src="/images/icons/home.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab" bindtap="orders"><image class="nav-icon" src="/images/icons/goods.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/business-active.png" mode="aspectFit"/><text>钱包</text></view><view class="bottom-tab" bindtap="settings"><image class="nav-icon" src="/images/icons/usercenter.png" mode="aspectFit"/><text>我的</text></view></view>
</view>
