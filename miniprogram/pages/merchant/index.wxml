<view class="page agent-page">
  <view class="agent-head"><view><view class="agent-kicker">今日运营</view><view class="agent-title">{{agent.name}}</view></view><view class="agent-status {{agent.enabled ? 'enabled' : 'disabled'}}">{{agent.enabled ? '合作中' : '已停用'}}</view></view>
  <view class="summary-card merchant-summary" bindtap="wallet"><view class="summary-label">可提现余额</view><view class="summary-value">¥{{balance}}</view><view class="summary-foot"><text>提现中 ¥{{pendingWithdraw}}</text><text>钱包明细 ›</text></view></view>
  <view class="metric-grid"><view class="metric-card"><view class="metric-label">待客户付款</view><view class="metric-value">{{pendingPayment}}</view><view class="metric-hint">等待客户完成付款</view></view><view class="metric-card"><view class="metric-label">待审核</view><view class="metric-value">{{pendingReview}}</view><view class="metric-hint">客户已提交通知</view></view><view class="metric-card"><view class="metric-label">本月已结算</view><view class="metric-value">¥{{monthSettlement}}</view><view class="metric-hint">{{settledCount}} 笔订单</view></view><view class="metric-card"><view class="metric-label">冻结金额</view><view class="metric-value">¥{{frozen}}</view><view class="metric-hint">待管理员打款</view></view></view>
  <view class="section-head"><view class="section-title">快捷操作</view></view>
  <view class="quick-grid"><view class="quick-item" bindtap="create"><image class="quick-image" src="/images/icons/goods.png" mode="aspectFit"/><view><view class="quick-name">创建订单</view><view class="quick-count">发起代付</view></view></view><view class="quick-item" bindtap="orders"><image class="quick-image" src="/images/icons/examples.png" mode="aspectFit"/><view><view class="quick-name">我的订单</view><view class="quick-count">{{pendingPayment + pendingReview}} 笔待处理</view></view></view><view class="quick-item" bindtap="wallet"><image class="quick-image" src="/images/icons/business.png" mode="aspectFit"/><view><view class="quick-name">钱包明细</view><view class="quick-count">查看余额和流水</view></view></view><view class="quick-item" bindtap="withdraw"><image class="quick-image" src="/images/icons/usercenter.png" mode="aspectFit"/><view><view class="quick-name">申请提现</view><view class="quick-count">提交资金申请</view></view></view></view>
  <view wx:if="{{alerts.length}}" class="section-head"><view class="section-title">运营提醒</view><view class="section-link" bindtap="orders">查看订单</view></view>
  <view wx:if="{{alerts.length}}" class="card notice-card"><view wx:for="{{alerts}}" wx:key="title" class="notice-row" bindtap="alertAction" data-action="{{item.action}}"><view class="notice-icon"><image src="{{item.icon}}" mode="aspectFit"/></view><view class="notice-copy"><view class="notice-title">{{item.title}}</view><view class="notice-meta">{{item.meta}}</view></view><view class="task-arrow">›</view></view></view>
  <view class="section-head"><view class="section-title">待处理</view><view class="section-link" bindtap="orders">全部订单</view></view>
  <view class="card task-card"><view wx:if="{{!tasks.length}}" class="notice-empty">当前暂无需要处理的事项</view><view wx:for="{{tasks}}" wx:key="id" class="task-item" bindtap="task" data-id="{{item.id}}"><view class="task-icon"><image src="{{item.icon}}" mode="aspectFit"/></view><view class="task-copy"><view class="task-name">{{item.title}}</view><view class="task-meta">{{item.meta}}</view></view><view class="task-arrow">›</view></view></view>
  <view class="bottom-nav"><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/home-active.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab" bindtap="orders"><image class="nav-icon" src="/images/icons/goods.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab" bindtap="wallet"><image class="nav-icon" src="/images/icons/business.png" mode="aspectFit"/><text>钱包</text></view><view class="bottom-tab" bindtap="settings"><image class="nav-icon" src="/images/icons/usercenter.png" mode="aspectFit"/><text>我的</text></view></view>
</view>
