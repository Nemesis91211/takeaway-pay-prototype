.page { padding-bottom:150rpx; }.wallet-page { padding-top:18rpx; }.wallet-head { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 20rpx; }.eyebrow { color:#a17b00; font-size:23rpx; font-weight:600; letter-spacing:1rpx; }.page-title { margin-top:6rpx; color:#202124; font-size:44rpx; font-weight:700; }.withdraw-entry { width:150rpx; height:62rpx; margin:0; border:1rpx solid #eadca5; border-radius:15rpx; background:#fffaf0; color:#806300; font-size:24rpx; }.balance-card { padding:28rpx; border-radius:22rpx; background:linear-gradient(135deg,#332c12,#6d5713); color:#fff; }.light-text { color:#e5dcae; }.balance { margin-top:10rpx; font-size:62rpx; font-weight:700; letter-spacing:1rpx; }.balance-foot { display:flex; justify-content:space-between; margin-top:26rpx; padding-top:18rpx; border-top:1rpx solid rgba(255,255,255,.16); color:#e5dcae; font-size:23rpx; }.ledger-tabs { width:100%; margin-bottom:16rpx; white-space:nowrap; }.ledger-tab { display:inline-flex; align-items:center; height:62rpx; margin-right:12rpx; padding:0 20rpx; border-radius:30rpx; background:#fff; color:#797c81; font-size:24rpx; }.ledger-tab.active { background:#202124; color:#fff; }.ledger { display:flex; align-items:center; justify-content:space-between; padding:24rpx; }.ledger-main { min-width:0; flex:1; }.ledger-title { overflow:hidden; color:#292b2f; font-size:27rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.ledger-amount { margin-left:18rpx; color:#b65757; font-size:31rpx; font-weight:700; white-space:nowrap; }.ledger-amount.income { color:#348451; }.empty-state { display:flex; flex-direction:column; align-items:center; margin-top:10rpx; padding:78rpx 20rpx; border-radius:18rpx; background:#fff; color:#7e8287; font-size:27rpx; }.empty-state text { margin-top:10rpx; color:#adb0b4; font-size:23rpx; }.empty-icon { display:flex; align-items:center; justify-content:center; width:74rpx; height:74rpx; margin-bottom:16rpx; border-radius:50%; background:#f5f6f7; }.empty-icon image { width:38rpx; height:38rpx; opacity:.5; }
