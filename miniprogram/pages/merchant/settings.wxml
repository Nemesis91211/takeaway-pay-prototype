<view class="page settings-page">
  <view class="settings-head"><view><view class="eyebrow">账号中心</view><view class="page-title">我的</view></view><view class="status-tag {{profile.enabled ? 'green' : 'gray'}}">{{profile.enabled ? '合作中' : '已停用'}}</view></view>
  <view class="card profile-card"><view class="profile-icon {{profile.avatar ? 'has-avatar' : ''}}" bindtap="changeAvatar"><image src="{{profile.avatar || '/images/icons/usercenter.png'}}" mode="{{profile.avatar ? 'aspectFill' : 'aspectFit'}}"/></view><view class="profile-summary"><view class="card-title">{{profile.name}}</view><view class="muted">账号：{{profile.username}}</view></view></view>
  <view class="section-head"><view class="section-title">个人信息</view></view><view class="card settings-list"><view class="setting-row" bindtap="editName"><view><view class="setting-name">代理人名称</view><view class="setting-meta">{{profile.name}}</view></view><view class="setting-value">修改 ›</view></view><view class="setting-row" bindtap="editContact"><view><view class="setting-name">联系人</view><view class="setting-meta">{{profile.contact || '未填写'}}</view></view><view class="setting-value">修改 ›</view></view><view class="setting-row"><view><view class="setting-name">登录手机号</view><view class="setting-meta">{{profile.phone || '未绑定'}}</view></view><view class="setting-value readonly">不可修改</view></view></view>
  <view class="section-head"><view class="section-title">收款设置</view></view><view class="card settings-list"><view class="setting-row" bindtap="account"><view><view class="setting-name">收款方式</view><view class="setting-meta">{{settings.payoutMethod}}</view></view><view class="setting-value">修改 ›</view></view><view class="setting-row"><view><view class="setting-name">提现权限</view><view class="setting-meta">由管理员统一配置</view></view><view class="setting-value readonly">{{settings.withdrawEnabled ? '已开放' : '已关闭'}}</view></view></view>
  <view class="section-head"><view class="section-title">平台规则</view></view><view class="card settings-list"><view class="setting-row"><view><view class="setting-name">结算规则</view><view class="setting-meta">审核通过后计入可用余额</view></view><view class="setting-value readonly">{{settings.reviewMode}}</view></view><view class="setting-row" bindtap="security"><view><view class="setting-name">修改登录密码</view><view class="setting-meta">定期更换密码，避免多人共用</view></view><view class="setting-value">修改 ›</view></view><view class="setting-row" bindtap="logout"><view><view class="setting-name">退出登录</view><view class="setting-meta">退出后需要重新输入账号密码</view></view><view class="setting-value">退出 ›</view></view></view>
  <view class="bottom-nav"><view class="bottom-tab" bindtap="home"><image class="nav-icon" src="/images/icons/home.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab" bindtap="orders"><image class="nav-icon" src="/images/icons/goods.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab" bindtap="wallet"><image class="nav-icon" src="/images/icons/business.png" mode="aspectFit"/><text>钱包</text></view><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/usercenter-active.png" mode="aspectFit"/><text>我的</text></view></view>
</view>
