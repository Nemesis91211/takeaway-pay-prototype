.page { padding-bottom:150rpx; }.agent-page { padding-top:20rpx; }.merchant-summary { background:linear-gradient(135deg,#8c6900 0%,#b58a00 100%); }.merchant-summary .summary-foot { border-color:rgba(255,255,255,.2); }.agent-head { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 22rpx; }.agent-kicker { color:#9b7500; font-size:23rpx; font-weight:600; letter-spacing:1rpx; }.agent-title { margin-top:5rpx; overflow:hidden; color:#202124; font-size:40rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.agent-status { padding:9rpx 16rpx; border-radius:24rpx; background:#e8f7eb; color:#2d8750; font-size:22rpx; }.agent-status.disabled { background:#f0f1f2; color:#7b7e83; }.metric-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:16rpx; }.metric-card { min-height:142rpx; padding:20rpx 22rpx; border:1rpx solid #eceef0; border-radius:18rpx; background:#fff; box-sizing:border-box; }.metric-label { color:#777b81; font-size:23rpx; }.metric-value { margin-top:9rpx; overflow:hidden; color:#24262a; font-size:36rpx; font-weight:700; line-height:1; text-overflow:ellipsis; white-space:nowrap; }.metric-hint { margin-top:12rpx; color:#a1a4a8; font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.notice-card { padding:4rpx 24rpx; }.notice-row { display:flex; align-items:center; padding:20rpx 0; border-bottom:1rpx solid #f0f1f2; }.notice-row:last-child { border-bottom:0; }.notice-icon { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; margin-right:15rpx; border-radius:15rpx; background:#fff2c7; }.notice-icon image { width:30rpx; height:30rpx; }.notice-copy { flex:1; min-width:0; }.notice-title { overflow:hidden; color:#2b2d31; font-size:26rpx; text-overflow:ellipsis; white-space:nowrap; }.notice-meta { margin-top:5rpx; overflow:hidden; color:#989ba0; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.notice-empty { padding:23rpx 0; color:#92959a; font-size:24rpx; text-align:center; }.task-icon { display:flex; align-items:center; justify-content:center; }.task-icon image { width:30rpx; height:30rpx; }
