.orders-page { padding-top:18rpx; }.orders-head { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 20rpx; }.eyebrow { color:#a17b00; font-size:23rpx; font-weight:600; letter-spacing:1rpx; }.page-title { margin-top:6rpx; color:#202124; font-size:44rpx; font-weight:700; }.create-button { width:120rpx; height:62rpx; margin:0; border:1rpx solid #e4e5e7; border-radius:15rpx; color:#7d650d; background:#fff; font-size:24rpx; }.search-box { display:flex; align-items:center; height:78rpx; margin-bottom:16rpx; padding:0 20rpx; border:1rpx solid #e7e8ea; border-radius:16rpx; background:#fff; box-sizing:border-box; }.search-box image { flex:none; width:34rpx; height:34rpx; margin-right:12rpx; opacity:.65; }.search-box input { flex:1; height:78rpx; color:#303237; font-size:26rpx; }.clear-search { padding:8rpx; color:#a1a4a8; font-size:34rpx; line-height:1; }.filter-bar { width:100%; margin-bottom:18rpx; white-space:nowrap; }.filter { display:inline-flex; align-items:center; height:62rpx; margin-right:12rpx; padding:0 20rpx; border-radius:30rpx; background:#fff; color:#797c81; font-size:24rpx; }.filter.active { background:#202124; color:#fff; }.list-head { display:flex; align-items:center; justify-content:space-between; margin:4rpx 4rpx 12rpx; color:#2a2c30; font-size:30rpx; font-weight:700; }.list-total { color:#a1a4a8; font-size:23rpx; font-weight:400; }.order-card { padding:24rpx; }.order-agent { margin-bottom:14rpx; color:#6d7076; font-size:24rpx; font-weight:600; }.order-agent text + text { color:#a17b00; font-weight:400; }.order-detail { margin-top:10rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.order-bottom { margin-top:20rpx; align-items:baseline; }.price { color:#9c7100; font-size:30rpx; font-weight:700; }.settle { margin-left:14rpx; color:#7d8186; font-size:22rpx; }.order-id { color:#a1a4a8; font-size:21rpx; }.review-countdown { margin-top:16rpx; padding:12rpx 16rpx; border-radius:10rpx; background:#fff5df; color:#a66b00; font-size:23rpx; }.card-action-row { display:flex; align-items:center; justify-content:space-between; margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid #f0f1f2; color:#9b7500; font-size:23rpx; }.small { width:auto; height:62rpx; margin:0; padding:0 18rpx; line-height:60rpx; font-size:24rpx; }.empty-state { display:flex; flex-direction:column; align-items:center; margin-top:10rpx; padding:78rpx 20rpx; border-radius:18rpx; background:#fff; color:#7e8287; font-size:27rpx; }.empty-state text { margin-top:10rpx; color:#adb0b4; font-size:23rpx; }.empty-icon { display:flex; align-items:center; justify-content:center; width:74rpx; height:74rpx; margin-bottom:16rpx; border-radius:50%; background:#f5f6f7; }.empty-icon image { width:38rpx; height:38rpx; opacity:.5; }.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:30; display:flex; align-items:flex-end; background:rgba(24,25,27,.42); }.detail-sheet { width:100%; padding:28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; box-sizing:border-box; }.sheet-head { display:flex; align-items:flex-start; justify-content:space-between; }.sheet-title { color:#24262a; font-size:34rpx; font-weight:700; }.sheet-id { margin-top:6rpx; color:#999da2; font-size:22rpx; }.sheet-close { padding:0 6rpx; color:#999da2; font-size:42rpx; line-height:34rpx; }.detail-hero { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:28rpx 0 22rpx; padding:22rpx; border-radius:16rpx; background:#faf6e7; }.detail-item { margin-bottom:7rpx; color:#292b2f; font-size:29rpx; font-weight:700; }.detail-section { padding:4rpx 4rpx 0; }.detail-row { display:flex; align-items:center; justify-content:space-between; min-height:62rpx; border-bottom:1rpx solid #f1f2f3; color:#85898e; font-size:25rpx; }.detail-row text:last-child { max-width:430rpx; overflow:hidden; color:#303237; text-align:right; text-overflow:ellipsis; white-space:nowrap; }.warning-text { color:#a66b00 !important; font-weight:700; }.sheet-actions { display:flex; gap:12rpx; margin-top:24rpx; }.sheet-actions button { flex:1; margin:0; }.sheet-actions .primary { width:auto; height:76rpx; }.sheet-actions .ghost { width:auto; height:76rpx; }
