<view class="page orders-page">
  <view class="orders-head"><view><view class="eyebrow">业务记录</view><view class="page-title">我的订单</view></view><button class="create-button" bindtap="goHome">首页</button></view>
  <view class="search-box"><image src="/images/icons/search.svg" mode="aspectFit"/><input value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" placeholder="搜索订单号、餐品或商家"/><text wx:if="{{keyword}}" class="clear-search" bindtap="clearKeyword">×</text></view>
  <scroll-view class="filter-bar" scroll-x="true" show-scrollbar="false"><view class="filter {{filter === '全部' ? 'active' : ''}}" bindtap="setFilter" data-filter="全部">全部</view><view class="filter {{filter === '待客户付款' ? 'active' : ''}}" bindtap="setFilter" data-filter="待客户付款">待付款</view><view class="filter {{filter === '待审核' ? 'active' : ''}}" bindtap="setFilter" data-filter="待审核">待审核</view><view class="filter {{filter === '已审核' ? 'active' : ''}}" bindtap="setFilter" data-filter="已审核">已结算</view><view class="filter {{filter === '已关闭' ? 'active' : ''}}" bindtap="setFilter" data-filter="已关闭">已关闭</view></scroll-view>
  <view class="list-head"><text>{{filter === '全部' ? '全部订单' : filter}}</text><text class="list-total">{{list.length}} 笔</text></view>
  <view wx:if="{{list.length}}"><view class="card order-card" wx:for="{{list}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}"><view class="order-agent"><text>{{item.merchant}}</text><text wx:if="{{item.customerName}}"> · {{item.customerName}}</text></view><view class="row"><view class="card-title">{{item.item}}</view><text class="tag {{item.statusClass}}">{{item.status}}</text></view><view class="muted order-detail">{{item.detail}}</view><view class="row order-bottom"><view><text class="muted">客户付款 </text><text class="price">¥{{item.payAmount}}</text><text class="settle">结算 ¥{{item.settleAmount}}</text></view><text class="order-id">{{item.id}}</text></view><view wx:if="{{item.status === '待审核'}}" class="review-countdown">审核倒计时 {{item.reviewCountdown}}</view><view class="card-action-row"><button class="ghost small" catchtap="copy" data-id="{{item.id}}">复制分享链接</button><text>查看详情 ›</text></view></view></view>
  <view wx:else class="empty-state"><view class="empty-icon"><image src="/images/icons/search.svg" mode="aspectFit"/></view><view>暂无符合条件的订单</view><text wx:if="{{keyword}}">试试更换搜索条件</text><text wx:else>创建订单后会显示在这里</text></view>
  <view wx:if="{{detailVisible}}" class="modal-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="stopPropagation"><view class="sheet-head"><view><view class="sheet-title">订单详情</view><view class="sheet-id">{{selected.id}}</view></view><text class="sheet-close" catchtap="closeDetail">×</text></view><view class="detail-hero"><view><view class="detail-item">{{selected.item}}</view><view class="muted">{{selected.merchant}} · {{selected.detail}}</view></view><text class="tag {{selected.statusClass}}">{{selected.status}}</text></view><view class="detail-section"><view class="detail-row"><text>客户付款</text><text>¥{{selected.payAmount}}</text></view><view class="detail-row"><text>代理人结算</text><text>¥{{selected.settleAmount}}</text></view><view class="detail-row"><text>客户微信</text><text>{{selected.customerName || '尚未付款'}}</text></view><view wx:if="{{selected.status === '待审核'}}" class="detail-row"><text>审核倒计时</text><text class="warning-text">{{selected.reviewCountdown}}</text></view></view><view class="sheet-actions"><button class="ghost" bindtap="preview">预览代付页</button><button class="primary" bindtap="copy" data-id="{{selected.id}}">复制分享链接</button></view></view></view>
  <view class="bottom-nav"><view class="bottom-tab" bindtap="goHome"><image class="nav-icon" src="/images/icons/home.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/goods-active.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab" bindtap="goWallet"><image class="nav-icon" src="/images/icons/business.png" mode="aspectFit"/><text>钱包</text></view><view class="bottom-tab" bindtap="goSettings"><image class="nav-icon" src="/images/icons/usercenter.png" mode="aspectFit"/><text>我的</text></view></view>
</view>
