.password-page { min-height: 100vh; padding: 40rpx 30rpx 60rpx; box-sizing: border-box; background: #f5f6f8; }
.password-notice { margin-bottom: 20rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #fff5df; color: #a66b00; font-size: 25rpx; line-height: 36rpx; }
.password-card { padding: 30rpx 28rpx 34rpx; border-radius: 24rpx; }
.password-card .primary { margin-top: 30rpx; }
.password-error { margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #ffebeb; color: #b84c4c; font-size: 24rpx; line-height: 34rpx; }
.password-back { margin-top: 18rpx; }
