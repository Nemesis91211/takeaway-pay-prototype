<view class="login-page">
  <view class="login-brand">
    <view class="brand-icon"><image src="/images/icons/business-active.png" mode="aspectFit" /></view>
    <view class="brand-title">外卖订单助手</view>
  </view>
  <view class="card login-card">
    <view class="field">
      <text class="label">登录账号</text>
      <input class="input" data-key="username" value="{{username}}" bindinput="onInput" maxlength="40" placeholder="请输入账号" />
    </view>
    <view class="field">
      <text class="label">登录密码</text>
      <input class="input" password data-key="password" value="{{password}}" bindinput="onInput" maxlength="40" placeholder="请输入密码" confirm-type="done" bindconfirm="submit" />
    </view>
    <view wx:if="{{error}}" class="login-error">{{error}}</view>
    <button class="primary" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">登录</button>
  </view>
  <view class="login-foot">账号由管理员统一开通</view>
</view>
