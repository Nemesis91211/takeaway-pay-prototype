page { background: #f2f2f2; }.payment-page { min-height: 100vh; padding: 56rpx 24rpx 36rpx; box-sizing: border-box; background: #f2f2f2; }.payment-summary { text-align: center; }.time-line { color: #96989c; font-size: 28rpx; line-height: 40rpx; }.time-value { margin-left: 18rpx; }.payment-amount { margin-top: 4rpx; color: #1f2022; font-size: 74rpx; font-weight: 700; line-height: 100rpx; }.payment-amount text { margin-right: 5rpx; font-size: 40rpx; vertical-align: 8rpx; }.merchant-line { color: #717378; font-size: 28rpx; line-height: 42rpx; }.merchant-line text { margin-left: 10rpx; color: #a5a7aa; }.method-card { display: flex; align-items: center; justify-content: space-between; height: 142rpx; margin-top: 122rpx; padding: 0 32rpx; border-radius: 18rpx; background: #fff; box-sizing: border-box; }.method-left { display: flex; align-items: center; color: #252629; font-size: 32rpx; font-weight: 500; }.method-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 14rpx; border-radius: 8rpx; background: #10c442; }.method-bubble { position: relative; width: 25rpx; height: 18rpx; border-radius: 5rpx; background: #fff; }.method-bubble::after { content: ''; position: absolute; right: 2rpx; bottom: -5rpx; width: 8rpx; height: 8rpx; background: #fff; transform: skewY(-35deg); }.selected-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 50%; background: #ffdb00; color: #252400; font-size: 26rpx; font-weight: 700; }.confirm-button { display:flex; align-items:center; justify-content:center; position: fixed; right: 30rpx; bottom: 38rpx; left: 30rpx; width:auto; height: 94rpx; padding:0; border-radius: 48rpx; background: var(--primary); color: var(--primary-text); font-size: 32rpx; font-weight: 700; line-height: 94rpx; }.confirm-button[disabled] { background: #d8d8d8; color: #888; }
