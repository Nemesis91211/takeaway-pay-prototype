.hero .title { display:none; }.detail-line { margin-top:18rpx; color:#64676c; font-size:27rpx; }.strong { color:#9e7300; font-weight:700; }.review-timer { display:flex; align-items:center; justify-content:space-between; margin:20rpx 0 8rpx; padding:18rpx 20rpx; border-radius:14rpx; background:#fff5df; color:#a66b00; font-size:25rpx; }.review-timer text:last-child { font-size:38rpx; font-weight:700; letter-spacing:2rpx; }.auto-note { margin-top:18rpx; color:#8c6d28; font-size:23rpx; }.proof { display:flex; align-items:center; margin-top:28rpx; padding:22rpx; border-radius:16rpx; background:#faf7e9; }.proof-icon { width:64rpx; height:64rpx; margin-right:18rpx; border-radius:16rpx; background:#ffe28a; color:#7a5a00; line-height:64rpx; text-align:center; }.notice { margin-top:18rpx; padding:22rpx; border-radius:14rpx; background:#f2f3f4; color:#71747a; font-size:25rpx; line-height:38rpx; }.danger { color:#b84c4c; }
