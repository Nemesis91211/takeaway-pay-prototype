<view class="page"><view class="dashboard-head"><view><view class="head-title">订单管理</view><view class="head-caption">按状态查看业务订单</view></view></view><view class="order-tools"><button class="search-entry" bindtap="search" aria-label="搜索订单"><image src="/images/icons/search.svg" mode="aspectFit"/></button><button class="create-order-button" bindtap="create">＋ 新建订单</button></view><view class="filter-bar"><view class="filter {{filter === '全部' ? 'active' : ''}}" bindtap="setFilter" data-filter="全部">全部</view><view class="filter {{filter === '待审核' ? 'active' : ''}}" bindtap="setFilter" data-filter="待审核">待审核</view><view class="filter {{filter === '已审核' ? 'active' : ''}}" bindtap="setFilter" data-filter="已审核">已审核</view><view class="filter {{filter === '已关闭' ? 'active' : ''}}" bindtap="setFilter" data-filter="已关闭">已关闭</view></view><view class="card order-card" wx:for="{{orders}}" wx:key="id" bindtap="open" data-id="{{item.id}}"><view class="order-agent"><text>{{item.agentName}}</text><text wx:if="{{item.customerName}}"> · {{item.customerName}}</text></view><view class="row"><view class="card-title">{{item.item}}</view><text class="tag {{item.status === '已驳回' ? 'red' : item.status === '已审核' ? 'green' : ''}}">{{item.status}}</text></view><view class="muted" style="margin-top:10rpx">{{item.merchant}} · {{item.detail}}</view><view class="row order-bottom"><view><text class="muted">客户付款 </text><text class="price">¥{{item.payAmount}}</text></view><view class="muted">{{item.id}}</view></view><view wx:if="{{item.status === '待审核'}}" class="review-countdown">审核倒计时 {{item.reviewCountdown}}</view><button class="ghost small" catchtap="copy" data-id="{{item.id}}">复制分享链接</button></view><view wx:if="{{!orders.length}}" class="empty-state">暂无符合条件的订单</view><view class="bottom-nav"><view class="bottom-tab" bindtap="goHome"><image class="nav-icon" src="/images/icons/home.png" mode="aspectFit"/><text>首页</text></view><view class="bottom-tab active"><image class="nav-icon" src="/images/icons/goods-active.png" mode="aspectFit"/><text>订单</text></view><view class="bottom-tab" bindtap="goWithdrawals"><image class="nav-icon" src="/images/icons/usercenter.png" mode="aspectFit"/><text>提现</text></view><view class="bottom-tab" bindtap="goSettings"><image class="nav-icon" src="/images/icons/setting.svg" mode="aspectFit"/><text>我的</text></view></view></view>
