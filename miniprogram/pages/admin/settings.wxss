.page { padding-bottom:150rpx; }.profile-card { display:flex; align-items:center; gap:18rpx; }.profile-card .muted, .my-entry-copy .muted, .setting-meta { display:none; }.profile-avatar { width:76rpx; height:76rpx; border-radius:24rpx; background-color:#fff1b6; background-position:center; background-repeat:no-repeat; background-size:44rpx 44rpx; flex:none; overflow:hidden; }.profile-avatar-img { display:block; width:76rpx; height:76rpx; border-radius:24rpx; }.profile-summary { flex:1; min-width:0; }.profile-card .muted { display:block; margin-top:7rpx; overflow:hidden; color:#999ca0; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.profile-settings .setting-meta { display:block; }.profile-settings .setting-row > view:first-child { min-width:0; }.profile-settings .setting-meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.readonly { color:#a1a4a8; font-size:22rpx; }.my-entry-card { display:flex; align-items:center; padding:22rpx 24rpx; }.my-entry-icon { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; margin-right:16rpx; border-radius:20rpx; background:#fff1b6; }.my-entry-icon image { width:40rpx; height:40rpx; }.my-entry-copy { flex:1; }.my-entry-arrow { color:#a1a4a8; font-size:40rpx; }.settings-list { padding:0 24rpx; }.setting-row { display:flex; align-items:center; justify-content:space-between; min-height:106rpx; border-bottom:1rpx solid #f0f1f2; }.setting-row:last-child { border-bottom:0; }.setting-name { color:#292b2f; font-size:28rpx; }.setting-meta { margin-top:7rpx; color:#999ca0; font-size:23rpx; }.setting-value { color:#a17b00; font-size:25rpx; }.profile-modal { max-height:88vh; }.profile-modal .modal-subtitle { display:block; }.profile-modal .modal-actions { margin-bottom:0; }
.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:30; display:flex; align-items:center; justify-content:center; padding:30rpx; background:rgba(20,22,25,.55); box-sizing:border-box; }.modal-card { width:100%; max-height:90vh; overflow-y:auto; padding:30rpx 26rpx; border-radius:26rpx; background:#fff; box-sizing:border-box; }.modal-title { color:#222428; font-size:34rpx; font-weight:700; }.modal-subtitle { margin:8rpx 0 20rpx; color:#96999e; font-size:22rpx; }.required { color:#d45d4c; }.optional { margin-left:8rpx; color:#a1a4a8; font-size:21rpx; }.modal-actions { display:flex; gap:12rpx; margin-top:24rpx; }.modal-actions button { flex:1; margin:0; }
