.page { padding-bottom:40rpx; }.search-panel { display:flex; gap:12rpx; align-items:center; margin-top:10rpx; }.search-input-wrap { flex:1; display:flex; align-items:center; min-width:0; height:82rpx; padding:0 18rpx; border:1rpx solid #e4e5e7; border-radius:16rpx; background:#fff; box-sizing:border-box; }.search-input-wrap image { flex:none; width:32rpx; height:32rpx; margin-right:10rpx; }.search-input { flex:1; min-width:0; height:80rpx; color:#292b2f; font-size:27rpx; }.clear-keyword { color:#a1a4a8; font-size:36rpx; }.search-button { display:flex; align-items:center; justify-content:center; flex:none; width:82rpx; height:82rpx; margin:0; padding:0; border-radius:16rpx; background:#ffcf19; }.search-button image { width:38rpx; height:38rpx; }.history-card { padding:0 24rpx; border-radius:18rpx; background:#fff; }.history-row { display:flex; align-items:center; justify-content:space-between; min-height:86rpx; border-bottom:1rpx solid #f0f1f2; }.history-row:last-child { border-bottom:0; }.history-main { display:flex; align-items:center; flex:1; color:#45484d; font-size:26rpx; }.history-main image { width:28rpx; height:28rpx; margin-right:12rpx; opacity:.65; }.history-delete { padding:16rpx; color:#a1a4a8; font-size:30rpx; }.result-card { padding:24rpx; }.result-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.result-head .card-title { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.result-agent { margin-top:12rpx; color:#777a7f; font-size:23rpx; }.result-meta { display:flex; justify-content:space-between; margin-top:18rpx; color:#9c7100; font-size:24rpx; }
