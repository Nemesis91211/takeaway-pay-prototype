<view class="page search-page"><view class="search-panel"><view class="search-input-wrap"><image src="/images/icons/search.svg" mode="aspectFit"/><input class="search-input" value="{{keyword}}" bindinput="input" bindconfirm="searchNow" confirm-type="search" placeholder="商家、价格或代理人"/><text wx:if="{{keyword}}" class="clear-keyword" catchtap="clearKeyword">×</text></view><button class="search-button" bindtap="searchNow"><image src="/images/icons/search.svg" mode="aspectFit"/></button></view><view wx:if="{{!searched && history.length}}" class="section-head"><view class="section-title">最近查询</view><view class="section-link" bindtap="clearHistory">清空</view></view><view wx:if="{{!searched && history.length}}" class="history-card"><view wx:for="{{history}}" wx:key="*this" class="history-row"><view class="history-main" bindtap="useHistory" data-keyword="{{item}}"><image src="/images/icons/examples.png" mode="aspectFit"/><text>{{item}}</text></view><text class="history-delete" catchtap="deleteHistory" data-keyword="{{item}}">×</text></view></view><view wx:if="{{searched}}" class="section-head"><view class="section-title">结果</view><view class="section-link">{{results.length}} 笔</view></view><view wx:if="{{searched && !results.length}}" class="empty-state">没有找到匹配订单</view><view wx:for="{{results}}" wx:key="id" class="card result-card" bindtap="open" data-id="{{item.id}}"><view class="result-head"><view class="card-title">{{item.item}}</view><text class="tag {{item.status === '已审核' ? 'green' : item.status === '已驳回' ? 'red' : ''}}">{{item.status}}</text></view><view class="result-agent">{{item.merchant}} · {{item.id}}</view><view class="result-meta"><text>代理人：{{item.agentName}}</text><text>客户付款 ¥{{item.payAmount}}</text></view></view><view wx:if="{{!searched && !history.length}}" class="empty-state">暂无历史查询</view></view>
