.page { padding-bottom:60rpx; }.monitor-summary { display:flex; justify-content:space-between; gap:12rpx; margin:18rpx 0; padding:22rpx; background:#202124; border-radius:22rpx; color:#fff; text-align:center; }.monitor-summary view { flex:1; display:flex; flex-direction:column; gap:6rpx; font-size:22rpx; color:#c9cbd0; }.summary-number { font-size:36rpx; font-weight:700; color:#fff; }.search-box { margin:18rpx 0 4rpx; }.agent-card { margin-bottom:16rpx; padding:24rpx; border-radius:20rpx; background:#fff; box-shadow:0 2rpx 14rpx rgba(32,33,36,.04); }.agent-card-head { display:flex; align-items:center; }.agent-avatar { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; margin-right:16rpx; border-radius:20rpx; background:#fff1b6; overflow:hidden; }.agent-avatar image { width:40rpx; height:40rpx; }.agent-avatar image.avatar-full { width:68rpx; height:68rpx; }.agent-intro { flex:1; min-width:0; }.agent-name { overflow:hidden; color:#25272b; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.agent-account { margin-top:7rpx; overflow:hidden; color:#92959a; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.agent-alert { display:flex; justify-content:space-between; margin-top:20rpx; padding:14rpx 16rpx; border-radius:12rpx; background:#f5f6f7; color:#777a7f; font-size:23rpx; }.agent-alert.has-alert { background:#fff5df; color:#a66b00; }.agent-metrics { display:grid; grid-template-columns:repeat(3,1fr); margin-top:18rpx; }.agent-metrics view { display:flex; flex-direction:column; gap:7rpx; padding:0 12rpx; border-right:1rpx solid #eceef0; }.agent-metrics view:first-child { padding-left:0; }.agent-metrics view:last-child { padding-right:0; border-right:0; }.agent-metrics text:first-child { color:#999ca0; font-size:21rpx; }.agent-metrics text:last-child { color:#292b2f; font-size:25rpx; font-weight:700; }.agent-card-foot { display:flex; justify-content:space-between; margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid #f0f1f2; color:#999ca0; font-size:21rpx; }.modal-mask { position:fixed; inset:0; z-index:30; display:flex; align-items:center; justify-content:center; padding:30rpx; background:rgba(20,22,25,.55); box-sizing:border-box; }.modal-card { width:100%; max-height:90vh; overflow-y:auto; padding:30rpx 26rpx; border-radius:26rpx; background:#fff; box-sizing:border-box; }.modal-title { color:#222428; font-size:34rpx; font-weight:700; }.modal-subtitle { margin:8rpx 0 20rpx; color:#96999e; font-size:22rpx; }.required { color:#d45d4c; }.optional { margin-left:8rpx; color:#a1a4a8; font-size:21rpx; font-weight:400; }.modal-actions { display:flex; gap:12rpx; margin-top:24rpx; }.modal-actions button { flex:1; margin:0; }.compact-notice { margin:0 0 16rpx; padding:16rpx; font-size:22rpx; line-height:32rpx; }.monitor-status { display:flex; align-items:center; gap:14rpx; margin:16rpx 0; }.risk-text { color:#a17b00; font-size:23rpx; }.monitor-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rpx; overflow:hidden; border:1rpx solid #eceef0; border-radius:16rpx; }.monitor-grid view { display:flex; flex-direction:column; gap:8rpx; padding:18rpx; background:#fafbfb; }.monitor-grid text:first-child { color:#999ca0; font-size:21rpx; }.monitor-grid text:last-child { color:#292b2f; font-size:25rpx; font-weight:600; }.modal-close { margin-top:14rpx; color:#8d9095; background:transparent; font-size:24rpx; }
