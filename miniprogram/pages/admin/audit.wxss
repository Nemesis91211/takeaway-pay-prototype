.search-bar { display:flex; align-items:center; gap:16rpx; margin:16rpx 24rpx; }
.search-input { flex:1; height:72rpx; padding:0 24rpx; background:#fff; border:1rpx solid #e4e5e7; border-radius:16rpx; font-size:28rpx; }
.search-btn { height:72rpx; min-width:140rpx; margin:0; padding:0 24rpx; border-radius:16rpx; background:#ffcf19; color:#322a00; font-size:27rpx; font-weight:700; }
.filter-scroll { white-space:nowrap; padding:0 24rpx 16rpx; }
.filter-chip { display:inline-block; padding:14rpx 28rpx; margin-right:12rpx; border-radius:32rpx; background:#fff; color:#6d7076; font-size:26rpx; border:1rpx solid #e4e5e7; }
.filter-chip.active { background:#322a00; color:#ffcf19; border-color:#322a00; font-weight:700; }
.stat-bar { padding:8rpx 24rpx 16rpx; color:#9a9da3; font-size:24rpx; }
.log-card { padding:24rpx; margin:0 24rpx 16rpx; }
.log-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14rpx; }
.log-action { font-size:30rpx; font-weight:700; color:#322a00; }
.log-time { font-size:24rpx; color:#9a9da3; }
.log-body { display:flex; flex-direction:column; gap:8rpx; }
.log-row { display:flex; font-size:26rpx; align-items:flex-start; gap:12rpx; }
.log-row .muted { color:#9a9da3; flex-shrink:0; width:96rpx; }
.role-tag { display:inline-block; padding:2rpx 10rpx; margin-left:8rpx; border-radius:8rpx; background:#fff5df; color:#a66b00; font-size:22rpx; }
.payload { color:#322a00; word-break:break-all; }
.mono { font-family:Menlo, Consolas, monospace; font-size:24rpx; }
.loading, .no-more, .empty-state { text-align:center; padding:32rpx; color:#9a9da3; font-size:26rpx; }
.modal-mask { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:10; }
.modal-panel { position:fixed; left:24rpx; right:24rpx; bottom:48rpx; background:#fff; border-radius:24rpx; padding:32rpx; z-index:11; max-height:80vh; overflow-y:auto; }
.modal-title { font-size:32rpx; font-weight:700; text-align:center; margin-bottom:24rpx; }
.modal-body { display:flex; flex-direction:column; gap:16rpx; }
.modal-row { display:flex; align-items:flex-start; gap:16rpx; font-size:26rpx; }
.modal-label { width:120rpx; color:#9a9da3; flex-shrink:0; }
.modal-value { flex:1; color:#322a00; word-break:break-all; }
.modal-payload { background:#f7f8fa; padding:16rpx; border-radius:12rpx; font-size:24rpx; white-space:pre-wrap; word-break:break-all; }
.modal-actions { margin-top:32rpx; display:flex; gap:16rpx; }
.modal-actions button { flex:1; height:80rpx; line-height:80rpx; font-size:28rpx; border-radius:16rpx; }
