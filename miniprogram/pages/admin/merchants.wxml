<view class="page"><view class="dashboard-head"><view><view class="head-title">代理人管理</view><view class="head-caption">快速掌握运营状态，点击卡片处理问题</view></view></view><view class="monitor-summary"><view><text class="summary-number">{{totalCount}}</text><text>全部代理人</text></view><view><text class="summary-number">{{enabledCount}}</text><text>合作中</text></view><view><text class="summary-number">{{pendingCount}}</text><text>待审核订单</text></view></view><button class="primary" bindtap="showAdd">＋ 新增代理人</button><view class="search-box"><input class="input" data-key="keyword" bindinput="input" value="{{keyword}}" placeholder="搜索账号、姓名或手机号" /></view><view class="filter-bar"><view class="filter {{filter === '全部' ? 'active' : ''}}" bindtap="setFilter" data-filter="全部">全部</view><view class="filter {{filter === '启用中' ? 'active' : ''}}" bindtap="setFilter" data-filter="启用中">合作中</view><view class="filter {{filter === '已停用' ? 'active' : ''}}" bindtap="setFilter" data-filter="已停用">已停用</view></view><view class="section-head"><view class="section-title">代理人运营概览</view><view class="section-link">{{list.length}} 人</view></view><view wx:for="{{list}}" wx:key="id" class="agent-card" bindtap="monitor" data-id="{{item.id}}"><view class="agent-card-head"><view class="agent-avatar"><image class="{{item.avatar ? 'avatar-full' : ''}}" src="{{item.avatar || '/images/icons/business.png'}}" mode="{{item.avatar ? 'aspectFill' : 'aspectFit'}}"/></view><view class="agent-intro"><view class="agent-name">{{item.name}}</view><view class="agent-account">账号：{{item.username}}</view></view><text class="tag {{item.enabled ? 'green' : 'gray'}}">{{item.enabled ? '合作中' : '已停用'}}</text></view><view class="agent-alert {{item.pending > 0 ? 'has-alert' : ''}}"><text>{{item.pending > 0 ? '待审核订单需处理' : '当前暂无待处理订单'}}</text><text>{{item.pending}} 笔 ›</text></view><view class="agent-metrics"><view><text>订单</text><text>{{item.orderCount}} 笔</text></view><view><text>已结算</text><text>¥{{item.settledDisplay}}</text></view><view><text>可用余额</text><text>¥{{item.balanceDisplay}}</text></view></view><view class="agent-card-foot"><text>{{item.phone}}</text><text>{{item.risk}}</text></view></view><view wx:if="{{!list.length}}" class="empty-state">暂无符合条件的代理人</view><view wx:if="{{showForm}}" class="modal-mask"><view class="modal-card"><view class="modal-title">{{formTitle}}</view><view class="modal-subtitle">带 <text class="required">*</text> 为必填字段</view><view class="field"><text class="label">登录账号 <text class="required">*</text></text><input class="input" data-key="username" bindinput="input" value="{{username}}" placeholder="例如：agent_001" /></view><view class="field"><text class="label">手机号 <text class="required">*</text></text><input class="input" type="number" data-key="phone" bindinput="input" value="{{phone}}" placeholder="用于登录和通知" /></view><view wx:if="{{!editingId}}" class="notice compact-notice">系统将自动生成默认密码，创建成功后只展示一次。</view><view class="field"><text class="label">代理人姓名 <text class="optional">选填</text></text><input class="input" data-key="name" bindinput="input" value="{{name}}" placeholder="不填写则使用登录账号" /></view><view class="field"><text class="label">联系人 <text class="optional">选填</text></text><input class="input" data-key="contact" bindinput="input" value="{{contact}}" placeholder="请输入联系人姓名" /></view><view class="field"><text class="label">邮箱 <text class="optional">选填</text></text><input class="input" data-key="email" bindinput="input" value="{{email}}" placeholder="用于接收运营通知" /></view><view class="field"><text class="label">备注 <text class="optional">选填</text></text><textarea class="textarea" data-key="note" bindinput="input" value="{{note}}" placeholder="记录合作范围或内部备注" /></view><view class="modal-actions"><button class="ghost" bindtap="closeForm">取消</button><button class="primary" bindtap="save">保存</button></view></view></view><view wx:if="{{monitorAgent}}" class="modal-mask"><view class="modal-card monitor-card"><view class="modal-title">{{monitorAgent.name}} · 运营详情</view><view class="monitor-status"><text class="tag {{monitorAgent.enabled ? 'green' : 'gray'}}">{{monitorAgent.enabled ? '合作中' : '已停用'}}</text><text class="risk-text">{{monitorAgent.risk}}</text></view><view class="monitor-grid"><view><text>登录账号</text><text>{{monitorAgent.username}}</text></view><view><text>手机号</text><text>{{monitorAgent.phone}}</text></view><view><text>订单总数</text><text>{{monitorAgent.orderCount}} 笔</text></view><view><text>待审核</text><text class="warning-text">{{monitorAgent.pending}} 笔</text></view><view><text>已结算</text><text>¥{{monitorAgent.settledDisplay}}</text></view><view><text>可用余额</text><text>¥{{monitorAgent.balanceDisplay}}</text></view></view><view class="modal-actions"><button class="ghost" data-action="orders" bindtap="monitorAction">查看订单</button><button class="ghost" data-action="edit" bindtap="monitorAction">编辑资料</button><button class="primary" data-action="toggle" bindtap="monitorAction">{{monitorAgent.enabled ? '停用账号' : '启用账号'}}</button></view><button class="modal-close" bindtap="closeMonitor">关闭</button></view></view></view>

