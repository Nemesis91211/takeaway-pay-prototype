<view class="page"><view class="hero"><view class="title">创建代付订单</view></view><view class="card"><view class="field"><text class="label">结算代理人</text><picker mode="selector" range="{{agentNames}}" value="{{agentIndex}}" bindchange="chooseAgent"><view class="select">{{agentNames[agentIndex] || '请选择代理人'}}</view></picker></view><view class="field"><text class="label">展示商家</text><input class="input" data-key="merchant" bindinput="onInput" value="{{merchant}}" placeholder="请输入订单展示的商家名称" /></view><view class="field"><text class="label">餐品名称</text><input class="input" data-key="item" bindinput="onInput" placeholder="例如：大桶柠檬茶" /></view><view class="field"><text class="label">餐品规格/备注</text><textarea class="textarea" data-key="detail" bindinput="onInput" placeholder="例如：少冰、双杯" /></view><button class="secondary" bindtap="chooseImage">{{imagePath ? '已选择餐品图片' : '选择餐品图片'}}</button><view class="field"><text class="label">客户支付金额</text><input class="input amount-input" type="digit" data-key="payAmount" bindinput="onInput" placeholder="¥ 0.00" /></view><view class="field"><text class="label">商家结算金额</text><input class="input amount-input" type="digit" data-key="settleAmount" bindinput="onInput" placeholder="¥ 0.00" /></view><button class="primary" bindtap="submit">保存并生成订单</button></view></view>
